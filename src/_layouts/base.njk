<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="alternate icon" href="favicon.svg">
  {% set canonPath = page.url %}
  {% if noindex %}
  <link rel="canonical" href="{{ site.siteOrigin }}/">
  {% else %}
  <link rel="canonical" href="{{ site.siteOrigin }}{{ canonPath }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.siteName }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.siteOrigin }}{{ canonPath }}">
  <meta property="og:image" content="{{ site.siteOrigin }}/assets/og-cover.png">
  <meta property="og:image:width" content="{{ site.ogImageWidth }}">
  <meta property="og:image:height" content="{{ site.ogImageHeight }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ twitterDescription or description }}">
  <meta name="twitter:image" content="{{ site.siteOrigin }}/assets/og-cover.png">
  <script>(function(){try{var s=JSON.parse(localStorage.getItem("mind-theme")||"{}");var d=document.documentElement;var dark=matchMedia("(prefers-color-scheme: dark)").matches;var m=s.mode;if(m!=="light"&&m!=="dark")m=dark?"dark":"light";d.setAttribute("data-mode",m);d.setAttribute("data-theme",s.theme||"sage")}catch(e){}})();</script>
  {% if nav == "home" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.siteName | dump | safe }},
    "url": {{ (site.siteOrigin + "/") | dump | safe }},
    "description": "面向普通人的心理自助与情绪安抚工具站",
    "inLanguage": "zh-CN"
  }
  </script>
  {% elif toolPage and not noindex %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "url": {{ (site.siteOrigin + canonPath) | dump | safe }},
    "isPartOf": {
      "@type": "WebSite",
      "name": {{ site.siteName | dump | safe }},
      "url": {{ (site.siteOrigin + "/") | dump | safe }}
    },
    "inLanguage": "zh-CN"
  }
  </script>
  {% endif %}
  <meta name="theme-color" content="#5e8c7e" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1a1f1c" media="(prefers-color-scheme: dark)">
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="apple-touch-icon" href="assets/icon-192.png">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>
  {% include "header.njk" %}
  {% include "crisis-bar.njk" %}

  <main id="main" class="{{ mainClass or 'container' }}">
    {% if toolPage and breadcrumbTitle %}
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="index.html">工具箱</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{{ breadcrumbTitle }}</span>
    </nav>
    {% elif toolPage %}
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="index.html">工具箱</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{{ title | replace(" · 心屿", "") }}</span>
    </nav>
    {% endif %}
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
  <script src="script.js"></script>
  {% if pageScript %}
  <script>
  {% include pageScript %}
  </script>
  {% endif %}
</body>
</html>
